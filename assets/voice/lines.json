 },
 "vo4": {
  "text": "وفي قلب منطقة زاخر...",
  "duration": 3.624
 },
 "vo5": {
  "text": "هنا... حيث تلتقي الطبيعة بالحياة.",
  "duration": 5.424
 },
 "vo6": {
  "text": "لايف هب بارك... وجهتك القادمة، في زاخر، العين.",
